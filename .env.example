# Project Atlas environment variables.
# Copy to .env for local development. Never commit real values.
# Variables marked (Mx) are not read by the application until that milestone.

# --- Core (M0) -----------------------------------------------------------------
# development | test | production. Production refuses to start with SQLite.
APP_ENV=development
LOG_LEVEL=INFO
# Local default (when unset): SQLite file at backend/var/atlas.db.
# Deployed: a managed PostgreSQL URL, e.g. from Neon (postgres:// or postgresql:// is accepted
# and normalised to the psycopg driver). Keep sslmode=require.
DATABASE_URL=
# Directory holding the built frontend (frontend/dist). Unset = API only.
FRONTEND_DIST_DIR=

# --- Store (M1) ----------------------------------------------------------------
# Only USD is accepted (ADR-003).
STORE_CURRENCY=USD
# 1 = run the create-only, idempotent demo seed after migrations on container start (ADR-022).
# Read by scripts/start.sh only; locally run `python -m app.seed` instead.
SEED_CATALOG_ON_START=0

# --- Store (M2) ----------------------------------------------------------------
# How long a cart's stock reservation holds (1-60 minutes, no renewal).
RESERVATION_TTL_MINUTES=15

# --- Store (M3) ----------------------------------------------------------------
# How long an order keeps the adopted stock hold before payment (M3, ADR-025). 15-60.
ORDER_HOLD_MINUTES=30
# PUBLIC_BASE_URL=https://<your-service>.onrender.com

# --- AI runtime (M5) -----------------------------------------------------------
# Natural-language discovery (ADR-005, ADR-028). Off unless LLM_PROVIDER=gemini and
# GEMINI_API_KEY is set; discovery then falls back to deterministic keyword matching.
# Get a key at https://aistudio.google.com/apikey. Never commit it or put it in frontend code.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=
# Fallback model when Gemini is unavailable or slow (enabled whenever GROQ_API_KEY is set).
# Get a key at https://console.groq.com/keys. GROQ_MODEL must support strict structured outputs.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# --- PayPal Sandbox (M3.2) -----------------------------------------------------
# Sandbox only (ADR-019). The API host is fixed in code (https://api-m.sandbox.paypal.com);
# there is no base-URL setting. Payments stay disabled (503 from the payment endpoints, the rest
# of the shop unaffected) unless PAYPAL_MODE=sandbox and all three values below are set.
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# The Sandbox business account's merchant id (13 characters); captures must be paid to it.
# PAYPAL_MERCHANT_ID=
# M3.3 (ADR-027): the id of the webhook registered on the same Sandbox app (Developer Dashboard ->
# the app -> Sandbox Webhooks), alphanumeric, at most 50 characters. PayPal's signature
# verification needs it. Without it POST /api/webhooks/paypal answers 503 (PayPal retries);
# capture and reconcile keep working.
# PAYPAL_WEBHOOK_ID=

# --- Make.com (M4) -------------------------------------------------------------
# MAKE_WEBHOOK_URL=
# MAKE_WEBHOOK_API_KEY=
# MAKE_SIGNING_SECRET=
# MAKE_CALLBACK_SECRET=
# OUTBOX_MAX_ATTEMPTS=8
# OUTBOX_BACKOFF_BASE_SECONDS=30
# OUTBOX_BACKOFF_CAP_SECONDS=1800

# --- Merchant dashboard (M8) ---------------------------------------------------
# SESSION_SECRET=
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=
